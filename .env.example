# Public project URL and publishable key from Supabase > Connect/API Keys.
# Legacy anon key also works in the publishable-key variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# No service_role key, database password or admin password is required.
