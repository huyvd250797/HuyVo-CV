{
  "name": "maison-cv",
  "version": "1.4.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:ui",
    "preview": "node scripts/preview.mjs",
    "check": "node scripts/check-content.mjs",
    "check:release": "node scripts/check-public.mjs",
    "test:cloud": "node --test tests/cloud.integration.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.3.1",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@fontsource/noto-serif": "5.3.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@react-pdf/layout": "4.4.3",
    "@react-pdf/render": "4.3.1"
  }
}
